# Copy to .env.local for local testing, or add these in Vercel:
# Project -> Settings -> Environment Variables. Never commit the real values.

# Cloud database (Supabase -> Project Settings -> API). Leave both out to use
# server/data/db.json on your own computer instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Assistant. With none of these it uses the BUILT-IN assistant (free, no AI,
# nothing leaves the app). For smarter free answers add a Groq key
# (console.groq.com -> API Keys, free tier, no card):
GROQ_API_KEY=gsk_...
# Optional
# AI_MODEL=openai/gpt-oss-120b
# APP_TIMEZONE=Asia/Singapore
# Other OpenAI-compatible service instead: AI_API_KEY=... AI_BASE_URL=https://.../v1 AI_MODEL=...
# Paid Claude API instead: ANTHROPIC_API_KEY=sk-ant-...  (ANTHROPIC_MODEL=claude-haiku-5-5)
